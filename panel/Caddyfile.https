{
	auto_https off
	admin 127.0.0.1:2019
	default_sni __PANEL_IP__
}

http://__PANEL_IP__ {
	handle /.well-known/acme-challenge/* {
		root * /acme
		file_server
	}
	redir https://__PANEL_IP__{uri} permanent
}

https://__PANEL_IP__ {
	tls /certs/fullchain.pem /certs/privkey.pem
	encode gzip
	header {
		Strict-Transport-Security "max-age=31536000; includeSubDomains"
		X-Content-Type-Options "nosniff"
		X-Frame-Options "DENY"
		Referrer-Policy "no-referrer"
		Content-Security-Policy "default-src 'self'; base-uri 'self'; form-action 'self'; frame-ancestors 'none'; img-src 'self' data:; style-src 'self' 'unsafe-inline'; script-src 'self' 'unsafe-inline'"
		Permissions-Policy "camera=(), microphone=(), geolocation=()"
		-Server
	}
	request_body {
		max_size 1MB
	}

	handle_path /releases/* {
		root * /srv/releases
		file_server {
			hide .*
		}
		header Cache-Control "public, max-age=300"
	}

	handle /api/agent/* {
		request_body {
			max_size 64KB
		}
		reverse_proxy panel:3000 {
			header_up X-Real-IP {remote_host}
			header_up X-Forwarded-For {remote_host}
		}
	}

	handle {
		reverse_proxy panel:3000 {
			header_up X-Real-IP {remote_host}
			header_up X-Forwarded-For {remote_host}
		}
	}
}
