{
  "name": "family-vpn",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "test:pairing": "node --experimental-strip-types --import ./scripts/register-alias.mjs --test lib/server/pairing.test.ts lib/server/compat-security.test.ts",
    "test:configs": "node --experimental-strip-types --import ./scripts/register-alias.mjs --test lib/server/wireguard.test.ts lib/server/configs.test.ts",
    "test:install-command": "node --experimental-strip-types --import ./scripts/register-alias.mjs --test lib/server/install-command.test.ts lib/server/client-ip.test.ts",
    "test:backup": "node --experimental-strip-types --import ./scripts/register-alias.mjs --test lib/server/backup-restore.test.ts",
    "test:security-scripts": "bash installer/client-isolation.test.sh && bash scripts/release-signing.test.sh",
    "test:agent": "bash scripts/run-agent-go-tests.sh",
    "test": "npm run test:pairing && npm run test:configs && npm run test:install-command && npm run test:backup && npm run test:security-scripts",
    "test:production": "bash scripts/verify-production-ready.sh",
    "release:agent": "bash scripts/build-release.sh"
  },
  "dependencies": {
    "next": "16.4.5",
    "qrcode": "^1.5.4",
    "react": "19.3.0",
    "react-dom": "19.3.0"
  },
  "devDependencies": {
    "@tailwindcss/turbopack": "^4",
    "@types/node": "^20",
    "@types/qrcode": "^1.5.6",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.4.5",
    "tailwindcss": "^4",
    "typescript": "^5"
  }
}
